<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>assist_arm</name>
  <version>0.1.0</version>
  <description>사람 손과 상호작용하는 가정용 로봇 (무접촉): 테이블 세팅/정리, 물 따르기, 음식 가져오기, 음악·율동, 테이블 닦기</description>
  <maintainer email="rokey@todo.todo">rokey</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>assist_arm_msgs</exec_depend>
  <exec_depend>od_msg</exec_depend>
  <exec_depend>dsr_msgs2</exec_depend>
  <!-- robot_control: onrobot.RG 그리퍼 클래스와 resource/T_gripper2camera.npy 재사용 -->
  <exec_depend>robot_control</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
